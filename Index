    <div class="essentials-grid">
        <!-- Food -->
        <div class="essential-card">
            <div class="essential-icon">🍽️</div>
            <h3>Must-Try Local Cuisine</h3>
            <ul class="essential-list">
                <li><strong>Naan & Biryani:</strong> Authentic Mughlai dishes</li>
                <li><strong>Khichdi:</strong> Traditional comfort food</li>
                <li><strong>Jaggery Sweets:</strong> Local delicacies</li>
                <li><strong>Chai & Snacks:</strong> Tea stalls throughout city</li>
            </ul>
            <p class="essential-tip">💡 Tip: Street vendors near heritage sites offer authentic experiences at budget prices.</p>
        </div>

        <!-- Hotels -->
        <div class="essential-card">
            <div class="essential-icon">🏨</div>
            <h3>Accommodation Options</h3>
            <ul class="essential-list">
                <li><strong>Luxury Hotels:</strong> 5-star near city center</li>
                <li><strong>Mid-range Hotels:</strong> Good comfort & value</li>
                <li><strong>Budget Lodges:</strong> Economical stays</li>
                <li><strong>Heritage Hotels:</strong> Unique cultural experience</li>
            </ul>
            <p class="essential-tip">💡 Tip: Book hotels near Panchakki or Bibi Ka Maqbara for easy site access.</p>
        </div>

        <!-- Transport -->
        <div class="essential-card">
            <div class="essential-icon">🚕</div>
            <h3>Local Transport</h3>
            <ul class="essential-list">
                <li><strong>Auto-Rickshaw:</strong> ₹10-50 for short distances</li>
                <li><strong>Taxis:</strong> ₹15/km (negotiate or use apps)</li>
                <li><strong>Local Buses:</strong> ₹5-20 per journey</li>
                <li><strong>Hired Vehicles:</strong> Full-day tours available</li>
            </ul>
            <p class="essential-tip">💡 Tip: Hire an auto for a full-day tour to multiple sites (₹1000-1500).</p>
        </div>

        <!-- Practical Info -->
        <div class="essential-card">
            <div class="essential-icon">ℹ️</div>
            <h3>Practical Information</h3>
            <ul class="essential-list">
                <li><strong>Best Season:</strong> October to March (cool weather)</li>
                <li><strong>Entry Fees:</strong> ₹50-500 depending on site</li>
                <li><strong>Languages:</strong> Hindi, Marathi, English spoken</li>
                <li><strong>Currency:</strong> Indian Rupee (INR)</li>
            </ul>
            <p class="essential-tip">💡 Tip: Carry water, sunscreen, and comfortable walking shoes.</p>
        </div>
    </div>
</section>

