<!-- ============ SITES GALLERY ============ -->
<section id="sites" class="sites-gallery">
    <div class="section-header">
        <h2 class="section-title">Historic Sites</h2>
        <p class="section-subtitle">Must-visit destinations with UNESCO recognition</p>
    </div>

    <div class="sites-container">
        <!-- Site Card 1: Ajanta Caves -->
        <article class="site-card" data-site="ajanta">
            <div class="site-image-wrapper">
                <div class="site-image placeholder-image">
                    <span class="placeholder-text">🎨</span>
                </div>
                <div class="site-badge">UNESCO</div>
            </div>
            <div class="site-content">
                <h3 class="site-title">Ajanta Caves</h3>
                <p class="site-description">
                    A cluster of 30 rock-cut Buddhist caves featuring intricate murals, sculptures, and architectural brilliance from the 2nd century BCE.
                </p>
                <div class="site-details">
                    <div class="detail">
                        <span class="detail-label">📍 Distance:</span>
                        <span>107 km from city</span>
                    </div>
                    <div class="detail">
                        <span class="detail-label">⏱️ Best Time:</span>
                        <span>Oct - Mar</span>
                    </div>
                </div>
                <div class="site-actions">
                    <a href="https://maps.google.com/?q=Ajanta+Caves" target="_blank" class="site-link">📍 View on Map</a>
                </div>
            </div>
        </article>

        <!-- Site Card 2: Ellora Caves -->
        <article class="site-card" data-site="ellora">
            <div class="site-image-wrapper">
                <div class="site-image placeholder-image">
                    <span class="placeholder-text">⛩️</span>
                </div>
                <div class="site-badge">UNESCO</div>
            </div>
            <div class="site-content">
                <h3 class="site-title">Ellora Caves</h3>
                <p class="site-description">
                    34 magnificent caves spanning Buddhist, Hindu, and Jain architecture. The Kailasa Temple is a masterpiece carved from a single rock.
                </p>
                <div class="site-details">
                    <div class="detail">
                        <span class="detail-label">📍 Distance:</span>
                        <span>29 km from city</span>
                    </div>
                    <div class="detail">
                        <span class="detail-label">⏱️ Best Time:</span>
                        <span>Oct - Mar</span>
                    </div>
                </div>
                <div class="site-actions">
                    <a href="https://maps.google.com/?q=Ellora+Caves" target="_blank" class="site-link">📍 View on Map</a>
                </div>
            </div>
        </article>

        <!-- Site Card 3: Bibi Ka Maqbara -->
        <article class="site-card" data-site="bibi">
            <div class="site-image-wrapper">
                <div class="site-image placeholder-image">
                    <span class="placeholder-text">🕌</span>
                </div>
                <div class="site-badge">Monument</div>
            </div>
            <div class="site-content">
                <h3 class="site-title">Bibi Ka Maqbara</h3>
                <p class="site-description">
                    The "Taj of the Deccan" — an exquisite mausoleum built by Aurangzeb for his wife Dilras Banu Begum. A stunning example of Mughal architecture.
                </p>
                <div class="site-details">
                    <div class="detail">
                        <span class="detail-label">📍 Distance:</span>
                        <span>6 km from city</span>
                    </div>
                    <div class="detail">
                        <span class="detail-label">⏱️ Best Time:</span>
                        <span>Oct - Mar</span>
                    </div>
                </div>
                <div class="site-actions">
                    <a href="https://maps.google.com/?q=Bibi+Ka+Maqbara" target="_blank" class="site-link">📍 View on Map</a>
                </div>
            </div>
        </article>

        <!-- Site Card 4: Daulatabad Fort -->
        <article class="site-card" data-site="daulatabad">
            <div class="site-image-wrapper">
                <div class="site-image placeholder-image">
                    <span class="placeholder-text">🏰</span>
                </div>
                <div class="site-badge">Monument</div>
            </div>
            <div class="site-content">
                <h3 class="site-title">Daulatabad Fort</h3>
                <p class="site-description">
                    An imposing medieval fort perched on a hilltop with triple concentric walls. Climb to the summit for panoramic views of the Deccan plateau.
                </p>
                <div class="site-details">
                    <div class="detail">
                        <span class="detail-label">📍 Distance:</span>
                        <span>15 km from city</span>
                    </div>
                    <div class="detail">
                        <span class="detail-label">⏱️ Best Time:</span>
                        <span>Oct - Mar (Morning)</span>
                    </div>
                </div>
                <div class="site-actions">
                    <a href="https://maps.google.com/?q=Daulatabad+Fort" target="_blank" class="site-link">📍 View on Map</a>
                </div>
            </div>
        </article>

        <!-- Site Card 5: Grishneshwar Temple -->
        <article class="site-card" data-site="grishneshwar">
            <div class="site-image-wrapper">
                <div class="site-image placeholder-image">
                    <span class="placeholder-text">🙏</span>
                </div>
                <div class="site-badge">Temple</div>
            </div>
            <div class="site-content">
                <h3 class="site-title">Grishneshwar Temple</h3>
                <p class="site-description">
                    One of the 12 sacred Jyotirlingas in India. An ancient Hindu temple with intricate stone carvings and spiritual significance.
                </p>
                <div class="site-details">
                    <div class="detail">
                        <span class="detail-label">📍 Distance:</span>
                        <span>32 km from city</span>
                    </div>
                    <div class="detail">
                        <span class="detail-label">⏱️ Best Time:</span>
                        <span>Year-round (Early morning)</span>
                    </div>
                </div>
                <div class="site-actions">
                    <a href="https://maps.google.com/?q=Grishneshwar+Temple" target="_blank" class="site-link">📍 View on Map</a>
                </div>
            </div>
        </article>

        <!-- Site Card 6: Panchakki -->
        <article class="site-card" data-site="panchakki">
            <div class="site-image-wrapper">
                <div class="site-image placeholder-image">
                    <span class="placeholder-text">💧</span>
                </div>
                <div class="site-badge">Historic</div>
            </div>
            <div class="site-content">
                <h3 class="site-title">Panchakki (Mill)</h3>
                <p class="site-description">
                    A historic 17th-century watermill built by Aurangzeb's governor. Named "Panchakki" (five mills), it's an engineering marvel of its time.
                </p>
                <div class="site-details">
                    <div class="detail">
                        <span class="detail-label">📍 Distance:</span>
                        <span>1 km from city center</span>
                    </div>
                    <div class="detail">
                        <span class="detail-label">⏱️ Best Time:</span>
                        <span>Oct - Mar</span>
                    </div>
                </div>
                <div class="site-actions">
                    <a href="https://maps.google.com/?q=Panchakki+Aurangabad" target="_blank" class="site-link">📍 View on Map</a>
                </div>
            </div>
        </article>
    </div>
